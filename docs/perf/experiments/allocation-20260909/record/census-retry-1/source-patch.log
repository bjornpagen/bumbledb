+// Keep fixture validity in the normal test run, without capturing allocation
+// backtraces or running the census's repeated measurement windows.
+#[test]
+fn census_fixture_smoke() {
+    schema().validate().expect("valid census schema");
+    for n in [4, 16, 64] {
+        wide_schema(n).validate().expect("valid wide schema");
+    }
+    let dir = common::TempDir::new("census-fixture-smoke");
+    let db = Db::create(dir.path(), schema(), common::work())
+        .expect("create")
+        .expect("accepted");
+    populate(&db);
+    for query in [
+        chain_query(8, 4, 1),
+        chain_query(2, 1, 8),
+        chain_query(2, 8, 1),
+        dnf_query(8),
+    ] {
+        db.prepare(&query, common::work()).expect("prepare");
+    }
+    for (query, params) in [
+        (join_query(), vec![BindValue::I64(0)]),
+        (interiors_only_query(), vec![BindValue::I64(0)]),
+        (aggregate_query(), vec![]),
+        (string_query(), vec![]),
+        (pack_query(), vec![]),
+        (calendar_query(), vec![BindValue::U64(2)]),
+        (marks_query(), vec![BindValue::U64(3)]),
+        (recursive_query(), vec![BindValue::U64(110)]),
+    ] {
+        let mut prepared = db.prepare(&query, common::work()).expect("prepare");
+        db.read(common::work(), |snap| {
+            snap.execute(&mut prepared, &params, &mut Answers::new())?;
+            Ok(())
+        })
+        .expect("execute fixture query");
+    }
+}
+
