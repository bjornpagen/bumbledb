{
	"name": "@bjornpagen/bumbledb",
	"version": "1.3.1",
	"description": "Effect-native embedded relational database for TypeScript: typed schemas and queries, exact floats, commit-time constraints",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./internal/log": {
			"types": "./dist/internal/log.d.ts",
			"default": "./dist/internal/log.js"
		}
	},
	"imports": {
		"#test/*.ts": "./test/*.ts",
		"#*.ts": {
			"bumbledb-src": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"pack-provenance.json",
		"dist",
		"src",
		"COOKBOOK.md"
	],
	"scripts": {
		"build": "node ../scripts/build-family.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "node --test 'test/**/*.test.ts'",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"database",
		"relational",
		"datalog",
		"embedded",
		"type-safe",
		"typescript"
	],
	"author": "Bjorn Pagen",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bjornpagen/bumbledb.git",
		"directory": "ts"
	},
	"homepage": "https://github.com/bjornpagen/bumbledb#readme",
	"dependencies": {
		"arkregex": "0.0.13"
	},
	"peerDependencies": {
		"effect": "^4.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@effect/platform-node": "catalog:",
		"@types/node": "26.6.4",
		"effect": "catalog:",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.10.1",
	"publishConfig": {
		"access": "public"
	},
	"private": false
}
