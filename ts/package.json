{
	"name": "@bjornpagen/bumbledb",
	"version": "2.0.0",
	"description": "Effect-native embedded relational database for TypeScript: typed schemas and queries, exact floats, commit-time constraints",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./engine": {
			"types": "./dist/engine.d.ts",
			"default": "./dist/engine.js"
		}
	},
	"bin": {
		"bumbledb": "./dist/bin.js"
	},
	"files": [
		"dist",
		"src",
		"COOKBOOK.md"
	],
	"scripts": {
		"build": "node scripts/build.ts release",
		"build:dev": "node scripts/build.ts dev",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "node --test --test-timeout=120000 'test/**/*.test.ts'"
	},
	"keywords": [
		"database",
		"relational",
		"datalog",
		"embedded",
		"type-safe",
		"typescript"
	],
	"author": "Bjorn Pagen",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bjornpagen/bumbledb.git",
		"directory": "ts"
	},
	"homepage": "https://github.com/bjornpagen/bumbledb#readme",
	"dependencies": {
		"arkregex": "0.0.13"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.1148.0",
		"effect": "^4.0.2"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1148.0",
		"@biomejs/biome": "2.5.15",
		"@types/node": "26.6.4",
		"effect": "catalog:",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.10.1",
	"publishConfig": {
		"access": "public"
	},
	"private": false
}
