{
	"name": "bumbledb-notes-example",
	"private": true,
	"description": "Server-only Next.js + Alchemy notes app over bumbledb: authenticated tenant bindings, one native runtime layer, LocalHistory dev flow, HostedHistory materialization, retained command refs, outbox idempotency, explicit schema initialization",
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "node --conditions react-server --experimental-strip-types --test 'test/routes.test.ts' 'test/specimens.test.ts'",
		"test:deployed": "node --experimental-strip-types --test 'test/deployed.test.ts'",
		"init-tenant": "node --experimental-strip-types scripts/init-tenant.ts",
		"dispatch-outbox": "node --experimental-strip-types scripts/dispatch-outbox.ts",
		"backup-restore": "node --experimental-strip-types scripts/backup-restore.ts",
		"resolve-command": "node --experimental-strip-types scripts/resolve-command.ts",
		"snapshot": "bumbledb-log snapshot --schema src/db/schema.ts --export App --out schema.json"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1148.0",
		"@bjornpagen/bumbledb": "1.3.1",
		"@bjornpagen/bumbledb-log": "1.3.1",
		"alchemy": "2.0.0-beta.81",
		"effect": "4.0.2",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"server-only": "0.0.1"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.2",
		"@types/node": "26.6.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"mongodb": "6.21.0",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.10.1"
}
