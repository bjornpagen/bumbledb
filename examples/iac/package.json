{
	"name": "bumbledb-iac-example",
	"private": true,
	"description": "Ephemeral AWS buckets for one local run of the real-S3 conformance suite: deploy, test, destroy",
	"type": "module",
	"scripts": {
		"deploy": "alchemy deploy --yes --no-input",
		"test:s3": "node scripts/test-s3.ts",
		"destroy": "node scripts/empty.ts && alchemy destroy --yes --no-input",
		"verify-clean": "node scripts/verify-clean.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1148.0",
		"@effect/platform-node": "4.0.2",
		"alchemy": "2.0.0-beta.81",
		"effect": "4.0.2"
	},
	"devDependencies": {
		"@types/node": "26.6.4"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.10.1"
}
