{
	"name": "@bjornpagen/bumbledb-log",
	"version": "0.20.3",
	"description": "Braided object-store replication for bumbledb: the command codec, theory-derived braids, and replica/writer over five store verbs",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"imports": {
		"#test/*.ts": "./test/*.ts",
		"#*.ts": {
			"bumbledb-src": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "node scripts/build.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "pnpm run build && node --test 'test/**/*.test.ts'",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"database",
		"replication",
		"object-storage",
		"bumbledb"
	],
	"author": "Bjorn Pagen",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bjornpagen/bumbledb.git",
		"directory": "ts-log"
	},
	"homepage": "https://github.com/bjornpagen/bumbledb#readme",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1116.0",
		"arkregex": "^0.0.8"
	},
	"peerDependencies": {
		"@bjornpagen/bumbledb": "0.20.3",
		"effect": "4.0.0-rc.112"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@bjornpagen/bumbledb": "link:../ts",
		"@types/node": "26.1.1",
		"effect": "4.0.0-rc.112",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.9.0",
	"publishConfig": {
		"access": "public"
	},
	"private": false
}
