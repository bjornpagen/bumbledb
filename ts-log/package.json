{
	"name": "@bjornpagen/bumbledb-log",
	"version": "1.3.1",
	"description": "Durable application commands, coherent readers, native schema transitions and generated schema bindings for BumbleDB (Effect-only)",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"default": "./dist/schema.js"
		}
	},
	"bin": {
		"bumbledb-log": "./dist/bin.js"
	},
	"imports": {
		"#test/*.ts": "./test/*.ts",
		"#*.ts": {
			"bumbledb-src": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"files": [
		"pack-provenance.json",
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "node ../scripts/build-family.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "node --test 'test/**/*.test.ts'",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"database",
		"commands",
		"history",
		"migrations",
		"bumbledb"
	],
	"author": "Bjorn Pagen",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bjornpagen/bumbledb.git",
		"directory": "ts-log"
	},
	"homepage": "https://github.com/bjornpagen/bumbledb#readme",
	"peerDependencies": {
		"@bjornpagen/bumbledb": "1.3.1",
		"effect": "4.0.0-rc.112"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@bjornpagen/bumbledb": "link:../ts",
		"@types/node": "26.1.1",
		"effect": "4.0.0-rc.112",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.9.0",
	"publishConfig": {
		"access": "public"
	},
	"private": false,
	"dependencies": {
		"@effect/platform-node": "4.0.0-rc.112"
	}
}
