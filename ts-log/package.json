{
	"name": "@bjornpagen/bumbledb-log",
	"version": "0.19.1",
	"description": "Braided object-store replication for bumbledb: the command codec, theory-derived braids, and replica/writer over five store verbs",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"imports": {
		"#test/*.ts": "./test/*.ts",
		"#*.ts": "./src/*.ts"
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "node --test 'test/**/*.test.ts'"
	},
	"keywords": [
		"database",
		"replication",
		"object-storage",
		"bumbledb"
	],
	"author": "Bjorn Pagen",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bjornpagen/bumbledb.git",
		"directory": "ts-log"
	},
	"homepage": "https://github.com/bjornpagen/bumbledb#readme",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1116.0",
		"@superbuilders/errors": "^4.0.2",
		"arkregex": "^0.0.8"
	},
	"peerDependencies": {
		"@bjornpagen/bumbledb": "^0.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@bjornpagen/bumbledb": "link:../ts",
		"@types/node": "26.1.1",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.9.0",
	"publishConfig": {
		"access": "public"
	},
	"private": false
}
